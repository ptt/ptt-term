{
  "name": "ptt-term",
  "version": "2.0.0",
  "type": "module",
  "dependencies": {
    "classnames": "^2.2.5",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@preact/preset-vite": "^2.10.6",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "vite": "^8.2.2"
  },
  "lint-staged": {
    "*.json": [
      "prettier --write"
    ],
    "src/components/**/*.{js,json,css}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "clean": "rimraf dist/assets dist/index.html",
    "prebuild": "npm run clean",
    "build": "vite build",
    "prebuild:dev": "npm run clean",
    "build:dev": "vite build --mode development",
    "start": "vite",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "prepare": "husky install"
  }
}
