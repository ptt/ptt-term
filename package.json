{
  "name": "ptt-term",
  "version": "2.0.2",
  "type": "module",
  "dependencies": {
    "classnames": "^2.5.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@preact/preset-vite": "^2.10.6",
    "husky": "^9.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "vite": "^8.3.0"
  },
  "lint-staged": {
    "*.json": [
      "prettier --write"
    ],
    "src/components/**/*.{js,json,css}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "clean": "rimraf dist/assets dist/index.html dist/manifest.webmanifest dist/*.png dist/sw.js dist/version.json",
    "prebuild": "npm run clean",
    "build": "vite build",
    "prebuild:dev": "npm run clean",
    "build:dev": "vite build --mode development",
    "start": "vite",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "prepare": "husky"
  }
}
